COMPOSE_PROJECT_NAME=tbtparent-me-production
# Copy the exact digest from the matching GitHub Release.
APP_IMAGE=ghcr.io/jojoshine/tbtparent-me@sha256:REPLACE_WITH_RELEASE_DIGEST
# Proposed allocation: check 31000 is free before first cutover; previous PM2 port is 5001.
APP_PORT=31000
# This project is deployed at the domain root. Keep empty; other prefixes are unsupported.
BASE_PATH=
# External PostgreSQL; app role: DML on app tables/sequences, no schema DDL.
DATABASE_URL=postgresql://app_user:CHANGE_ME@host.docker.internal:5432/tbtparent?schema=public
# Separate migration role: required schema DDL plus DML for data migrations/bootstrap.
MIGRATION_DATABASE_URL=postgresql://migration_user:CHANGE_ME@host.docker.internal:5432/tbtparent?schema=public
ADMIN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
MINIO_ENDPOINT=host.docker.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=tbtparent-me
BAIDU_IP_AK=
ALLOWED_ORIGINS=https://tbtparent.me,https://www.tbtparent.me
